# Copy to .env and fill in. Names only here; never commit values.

# Root of the data folder (config, inbox, cases, outbox, ...). Defaults to ./data
ADJUD_DATA_DIR=

# E-mail notifications (plan P-29). Leave SMTP_HOST empty to keep notifications in the
# outbox only. Outlook: smtp.office365.com, port 587, your address and an app password
# (only if your tenant allows SMTP AUTH). Mailpit: host mailpit or localhost, port 1025.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Demo: send every message to this one address (the presenter's inbox).
SMTP_REDIRECT_TO=
# Where links in e-mails and Slack messages point. Defaults to http://localhost:8501
APP_BASE_URL=

# Channels that deliver notifications (plan P-54, ADR 0002), e.g. outbox,smtp,slack.
# Leave empty for today's behaviour: e-mail when SMTP_HOST is set. The outbox is always
# written. Slack runs alongside e-mail on trial and never replaces it.
NOTIFY_CHANNELS=
# Incoming webhook of the demo channel in a separate demo workspace (https only). A
# secret: anyone with it can post to the channel.
SLACK_WEBHOOK_URL=

# AI (plan step 12). Only once API access is approved.
ANTHROPIC_API_KEY=
# Only for a key that is not scoped to a workspace: the workspace to bill (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
