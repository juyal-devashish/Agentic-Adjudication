# Copy to .env and fill in. Names only here; never commit values.

# Root of the data folder (config, inbox, cases, outbox, ...). Defaults to ./data
ADJUD_DATA_DIR=

# E-mail notifications (plan P-29). Leave SMTP_HOST empty to keep notifications in the
# outbox only. Outlook: smtp.office365.com, port 587, your address and an app password
# (only if your tenant allows SMTP AUTH). Mailpit: host mailpit or localhost, port 1025.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Demo: send every message to this one address (the presenter's inbox).
SMTP_REDIRECT_TO=
# Where links in e-mails and Slack messages point. Defaults to http://localhost:8501
APP_BASE_URL=

# Channels that deliver notifications, e.g. outbox,smtp,slack. Leave empty for e-mail
# only (when SMTP_HOST is set). The outbox is always written; e-mail stays on next to Slack.
NOTIFY_CHANNELS=
# The Slack app (plan P-55, ADR 0003), in a separate demo workspace. Secrets: .env only.
# Bot User OAuth Token (xoxb-...): DMs from the runner, replies from the Slack app.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write: Socket Mode, no public address.
SLACK_APP_TOKEN=

# AI (plan step 12). Only once API access is approved.
ANTHROPIC_API_KEY=
# The Slack Agent's own AI mode (P-58: off | replay | live), over study.yaml; e.g. live
# while ADJUD_AI_MODE=replay keeps the Quality Check agents on recorded answers
ADJUD_AGENT_MODE=
# Only for a key that is not scoped to a workspace: the workspace to bill (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
